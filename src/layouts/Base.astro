---
import '@fontsource-variable/bricolage-grotesque/standard.css';
import '@fontsource-variable/manrope';
import '@fontsource/instrument-serif/latin-400-italic.css';
import '@fontsource-variable/geist-mono';
import '@/styles/tokens.css';
import '@/styles/global.css';
import '@/styles/v2.css';
import '@/styles/compact.css';
import displayLatin from '@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-standard-normal.woff2?url';
import textLatin from '@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { alternatePath, htmlLang, locales, defaultLocale, type Locale } from '@/i18n/utils';
import { ui } from '@/i18n/ui';
import { site } from '@/config/site';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  isHome?: boolean;
  ogType?: 'website' | 'article';
  jsonLd?: Record<string, unknown>[];
  noindex?: boolean;
}
const { locale, title, description, isHome = false, ogType = 'website', jsonLd = [], noindex = false } = Astro.props;
const t = ui[locale];
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(locale === 'en' ? '/og-en.jpg' : '/og.jpg', Astro.site);
---

<!doctype html>
<html lang={htmlLang[locale]} data-theme="dark" data-intro={isHome ? '' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline src="/init.js"></script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <link rel="preload" href={displayLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={textLatin} as="font" type="font/woff2" crossorigin />
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && <link rel="canonical" href={canonical} />}
    {!noindex && locales.map((l) => <link rel="alternate" hreflang={htmlLang[l]} href={new URL(alternatePath(Astro.url.pathname, l), Astro.site)} />)}
    {!noindex && <link rel="alternate" hreflang="x-default" href={new URL(alternatePath(Astro.url.pathname, defaultLocale), Astro.site)} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#070d26" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={locale === 'en' ? 'Omar Rivera, software engineering student at UPC, over blue fluted glass.' : 'Omar Rivera, estudiante de Ingeniería de Software en la UPC, sobre vidrio estriado azul.'} />
    <meta property="og:locale" content={locale === 'es' ? 'es_PE' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {jsonLd.map((data) => <script is:inline type="application/ld+json" set:html={JSON.stringify(data).replace(/</g, '\\u003c')} />)}
  </head>
  <body>
    <a class="skip" href="#contenido">{t.skip}</a>
    <div class="progress" aria-hidden="true"></div>
    {
      isHome && (
        <div class="intro" aria-hidden="true">
          <span class="mono">{site.location}</span>
          <p class="intro__name">
            <span>{site.shortName}</span>
          </p>
          <div class="intro__foot">
            <span class="mono">{t.intro}</span>
            <span class="intro__count">000</span>
          </div>
          <span class="intro__bar" />
        </div>
      )
    }
    <Header locale={locale} isHome={isHome} />
    <main id="contenido">
      <slot />
    </main>
    <Footer locale={locale} />
    <div class="cursor" aria-hidden="true">
      <span class="cursor__ring"><span class="cursor__label"></span></span>
      <span class="cursor__dot"></span>
    </div>
    <script>
      import '@/scripts/app.ts';
    </script>
  </body>
</html>
